{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LC Pacientes",
  "version": "0.1.0",
  "identifier": "br.com.louriednacosta.pacientes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LC Pacientes",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset:; connect-src 'self' ipc: tauri:; frame-src 'none'; object-src 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Felipe — LC Consultório",
    "copyright": "Copyright © 2026 Louriedna Costa Pereira (CRP 03/29434)",
    "shortDescription": "LC Pacientes — Sistema de Pacientes e Documentos",
    "longDescription": "Sistema desktop 100% offline de gestão clínica desenvolvido sob medida para a psicóloga Louriedna Costa Pereira (CRP 03/29434).",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["PortugueseBR"],
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
