# Arquivo de exemplo para variáveis de ambiente (desenvolvimento).
# O sistema é 100% offline e local — NENHUMA chave de API ou credencial de nuvem é necessária.
# As chaves criptográficas (SQLCipher e XChaCha20-Poly1305) são derivadas em memória
# via Argon2id a partir da senha mestra e da chave de recuperação da usuária.

# Endereço do host de desenvolvimento Tauri (opcional, padrão localhost)
TAURI_DEV_HOST=localhost

# Porta do servidor Vite em modo de desenvolvimento
VITE_PORT=5173

# Nível de log do backend Rust (error, warn, info, debug, trace)
RUST_LOG=info
