# Fim de linha fixado no repositório.
# Garante consistência entre o ambiente de desenvolvimento (Linux) e de implantação (Windows).

* text=auto

# Textos e código-fonte: sempre LF
*.rs        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sql       text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.py        text eol=lf
.gitignore  text eol=lf
.editorconfig text eol=lf

# Scripts específicos do Windows: CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Arquivos binários: preservados sem conversão
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.icns      binary
*.pdf       binary
*.docx      binary
*.xlsx      binary
*.ttf       binary
*.db        binary
*.sqlite    binary
*.lcbackup  binary
*.lotusbackup binary
